# BillerQ AI Copilot — Environment Configuration
# ================================================
# Copy this to .env and fill in your values.
#
# Architecture: Hybrid Intelligence
#   - 70%+ requests handled client-side (NO AI, instant)
#   - Backend handles: analysis, workflows, complex queries, customer search
#   - Default: Ollama (local, free). Switch to "bedrock" for AWS (faster).

# ── BillerQ Admin API ────────────────────────────────────────────────────────
ADMIN_API_BASE=https://admin.billerq.com/public/api

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" | "bedrock"
#   ollama  → Uses local Ollama (free, no cloud account needed)
#   bedrock → Uses AWS Bedrock (faster, Claude 3.5 Haiku recommended)
LLM_PROVIDER=ollama

# ── Ollama Configuration (LLM_PROVIDER=ollama) ───────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Amazon Bedrock Configuration (LLM_PROVIDER=bedrock) ──────────────────────
#
# Recommended Model: Claude 3.5 Haiku
#   ⭐ claude-3-5-haiku-20241022 → BEST CHOICE for copilot:
#      • Fastest response time (~1-2s)
#      • Cheapest Bedrock Claude model
#      • Great for intent detection, summaries, dashboard queries
#      • Cost: $0.0008/1K input, $0.004/1K output tokens
#
# For complex analysis: Claude 3.5 Sonnet
#   claude-3-5-sonnet-20241022 → Use for trend analysis, deep insights
#   Cost: $0.003/1K input, $0.015/1K output tokens
#
# Why NOT other models:
#   • Titan: Not as capable for chat/analysis
#   • Llama: Better run locally via Ollama
#   • Jurassic: More expensive, not better for this use case
#
BEDROCK_REGION=us-east-1
BEDROCK_HAIKU_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_SONNET_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ACCESS_KEY=your-aws-access-key
BEDROCK_SECRET_KEY=your-aws-secret-key

# ── MySQL Database (Optional, for richer queries) ────────────────────────────
# Connect to BillerQ's MySQL database for customer lookup, overdue queries, etc.
# Leave empty to use Dashboard API only (still works without DB).
DB_HOST=localhost
DB_PORT=3306
DB_USER=billerq_user
DB_PASSWORD=your-db-password
DB_NAME=billerq

# ── Server ───────────────────────────────────────────────────────────────────
# Port to run the copilot API on
COPILOT_PORT=8001